<div class="mx-auto mt-16 max-w-2xl text-center">
    <p class="text-7xl font-extrabold tracking-tight text-transparent bg-gradient-to-r from-indigo-500 via-violet-500 to-fuchsia-500 bg-clip-text">404</p>
    <h1 class="mb-3 mt-4 text-3xl">{t 'error404.title'}</h1>
    <p class="lead py-0">{t 'error404.lead'}</p>
    <div class="card mt-8 text-left">
        <h2 class="mb-2 mt-0 text-base">{t 'error404.reasons'}</h2>
        <ul class="m-0 list-disc space-y-1 pl-5 text-sm text-slate-600">
            <li>{t 'error404.r1'}</li>
            <li>{t 'error404.r2'}</li>
            <li>{t 'error404.r3'}</li>
        </ul>
    </div>
    <p class="mt-8"><a class="btn-primary" href="{'/'|lurl}">{t 'error404.home'}</a></p>
</div>

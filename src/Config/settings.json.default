{
  "timeZone": "Europe/Prague",
  "codePage": "utf8",
  "minimizeHtml": false,
  "minimizeCss": false,
  "minimizeJs": false,
  "debug": false,
  "apiV2": {
    "enabled": true
  },
  "googleAnalytics": {
    "measurementId": ""
  },
  "cdnPath": "",
  "renderer": {
    "adapterName": "NativeRenderer",
    "autoEscape": true,
    "templatesDir": "/View/",
    "compiledDir": "Compiled/",
    "configDir": "/Config/"
  },
  "dbAdapterDefinition": {
    "adapterName": "Mysqli",
    "database": "wbengine_skeleton_app",
    "charset": "utf8",
    "port": "3306",
    "hostname": "db",
    "username": "dev_user",
    "password": "dev_password"
  },
  "jwt": {
    "accessKey": "CHANGE_ME",
    "refreshKey": "CHANGE_ME"
  },
  "recaptcha": {
    "secretKey": ""
  },
  "http": {
    "trustedProxies": [],
    "forwardedHeaders": []
  },
  "cache": {
    "enabled": true,
    "driver": "file",
    "ttl": 300,
    "pages": {
      "enabled": true,
      "ttl": 60
    }
  },
  "i18n": {
    "enabled": true,
    "default": "en",
    "locales": ["en", "cs"],
    "detect": ["url"]
  },
  "cssFiles": [],
  "ipAdmins": []
}
